# Local backup recovery only. The container worker needs additional settings.
# Copy to the checkout's .env only if it does not already exist; chmod 600 .env.
# Never commit real secrets. Use the API hostname returned by OAuth.
PCLOUD_API_HOST=eapi.pcloud.com
# Configure exactly one selector; leave the other empty.
PCLOUD_FOLDER_ID=123456789012345678
PCLOUD_FOLDER_PATH=
PCLOUD_TOKEN=
