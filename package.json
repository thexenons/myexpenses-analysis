{
  "name": "myexpenses-analysis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --jsx-a11y-plugin --vitest-plugin --deny-warnings",
    "preview": "vite preview",
    "data:import-backup": "tsx scripts/import-backup/cli.ts",
    "data:encrypt": "tsx scripts/encrypt-dataset/cli.ts",
    "data:encrypt:dev": "tsx scripts/encrypt-dataset/cli.ts --allow-empty-passphrase-for-development",
    "deploy:sync-pcloud": "tsx scripts/sync-pcloud/main.ts",
    "test": "pnpm test:node && pnpm test:ui",
    "test:coverage": "pnpm test:node:coverage && pnpm test:ui:coverage",
    "test:node": "tsx --test \"scripts/**/*.test.ts\" \"tests/domain/**/*.test.ts\" \"tests/architecture/**/*.test.ts\"",
    "test:node:coverage": "tsx --test --experimental-test-coverage \"scripts/**/*.test.ts\" \"tests/domain/**/*.test.ts\" \"tests/architecture/**/*.test.ts\"",
    "test:ui": "vitest run",
    "test:ui:coverage": "vitest run --coverage --maxWorkers=1 --testTimeout=60000 --hookTimeout=60000 --coverage.reporter=text --coverage.reporter=json-summary",
    "test:ui:watch": "vitest",
    "type-check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.2.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sql.js": "1.4.11",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.0.1",
    "oxlint": "1.79.0",
    "sql.js": "1.14.2",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
