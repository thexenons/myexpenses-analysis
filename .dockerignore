# Send only the inputs named by Dockerfile, not the whole local checkout.
**
!Dockerfile
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!index.html
!vite.config.ts
!vitest.config.ts
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!patches/
!patches/**
!src/
!src/**
!scripts/
!scripts/**
!tests/
!tests/**
!deploy/
!deploy/nginx.coolify.conf

# Exceptions inside allowed source trees never carry local private material.
**/.env*
**/app-dataset.json
**/app-dataset.vault.json
**/*.vault.json
src/**/*.json
scripts/**/*.json
tests/**/*.json
patches/**/*.json
**/*.sql
**/*.db
**/*.sqlite*
**/*.zip
**/*.token
**/*.passphrase
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/private/**
**/secrets/**
**/backups/**
